name: mynzo_app
description: "Mynzo Social World Platform With 30 Profiles."
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '^3.5.0'

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.8

flutter:
  uses-material-design: true
  # यह हिस्सा ऐप को आपकी logo.png इमेज पढ़ने की अनुमति देता है
  assets:
    - assets/images/logo.png
